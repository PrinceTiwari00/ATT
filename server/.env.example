# ── ATT · Attendance Tracking System — server configuration ──────────────
# Copy to .env (or export in your shell) — every value is optional.
# PRODUCTION DEFAULTS: real device, no demo data.

# API server
PORT=4000
HOST=0.0.0.0

# SQLite database file (created on first boot; schema auto-migrates)
DB_PATH=./data/attendance.db

# ── ZKTeco device link ────────────────────────────────────────────────────
ZK_MODE=real                     # 'real' = physical terminal | 'mock' = dev simulator
ZK_IP=192.168.1.201              # your terminal's static IP (see docs/HARDWARE_SETUP.md)
ZK_PORT=4370                     # TCP comm port as configured on the device
ZK_TIMEOUT_MS=10000
ZK_INPORT=5200

# ── Background poller ─────────────────────────────────────────────────────
POLL_ENABLED=true
POLL_INTERVAL_MINUTES=1

# Retry / circuit breaker for an unreachable device
ZK_RETRY_ATTEMPTS=3
ZK_RETRY_BASE_DELAY_MS=750
ZK_BREAKER_THRESHOLD=5
ZK_BREAKER_COOLDOWN_MS=60000

# ── Development-only (never used in production) ───────────────────────────
# SEED_DEMO=true                 # create fake roster+history on empty DB
# SEED_HISTORY_DAYS=9
# ZK_MOCK_DAY_MODE=complete      # mock sim: 'complete' | 'live'
# ZK_MOCK_FAILURE_RATE=0         # mock sim: 0..1 random connection drops
