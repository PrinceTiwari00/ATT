# ── ATT · Attendance Tracking System — server configuration ──────────────
# Copy to .env (or export in your shell) — every value is optional.

# API server
PORT=4000
HOST=0.0.0.0

# SQLite database file
DB_PATH=./data/attendance.db

# ── ZKTeco device link ────────────────────────────────────────────────────
# 'mock' = built-in device simulator (default, no hardware needed)
# 'real' = connect to the physical ZKTeco terminal over TCP/IP
ZK_MODE=mock
ZK_IP=192.168.1.201
ZK_PORT=4370
ZK_TIMEOUT_MS=10000
ZK_INPORT=5200

# Mock simulator extras
ZK_MOCK_DAY_MODE=complete        # 'complete' (full day visible) | 'live' (punches trickle in)
ZK_MOCK_FAILURE_RATE=0           # 0..1, simulate random connection drops

# ── Background poller ─────────────────────────────────────────────────────
POLL_ENABLED=true
POLL_INTERVAL_MINUTES=1

# Retry / circuit breaker for an unreachable device
ZK_RETRY_ATTEMPTS=3
ZK_RETRY_BASE_DELAY_MS=750
ZK_BREAKER_THRESHOLD=5
ZK_BREAKER_COOLDOWN_MS=60000

# ── Demo data ─────────────────────────────────────────────────────────────
SEED_DEMO=true                   # seed roster + history on first boot
SEED_HISTORY_DAYS=9
