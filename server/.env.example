# ── ATT · Attendance Tracking System — server configuration ──────────────
# Copy to .env (or export in your shell) — every value is optional.
# PRODUCTION DEFAULTS: real device, no demo data.

# API server
PORT=4000
HOST=0.0.0.0

# SQLite database file (created on first boot; schema auto-migrates)
DB_PATH=./data/attendance.db

# ── ZKTeco device link ────────────────────────────────────────────────────
# Site device (verified): ZKTeco K14 · fw 4.0.1(74) · ZKFinger VX10.0
# SN ONP6080486080200092 · static IP · DHCP off · Comm Key (Password) = 0
ZK_MODE=real                     # real = same-LAN server | bridge = cloud + LAN agent | mock = simulator
ZK_IP=192.168.1.110              # your terminal's static IP (see docs/HARDWARE_SETUP.md)
ZK_PORT=4370                     # TCP comm port as configured on the device
ZK_TIMEOUT_MS=10000
ZK_INPORT=5200

# Comm Key — the terminal's connection password (Menu → COMM → Comm Key).
# Must EQUAL the value on the device. 0 = the factory setting: the terminal
# answers ANY program on the LAN, so other software can steal its single
# session from ATT. A non-zero key makes them fail the handshake instead.
# Change it from the UI (Device & Sync → Terminal password) or set it here —
# ATT authenticates with it on every connection and sends it to the LAN agent
# in bridge mode. Treat it like a password: keep it out of version control.
# ZK_COMM_KEY=1

# ── Device session lock (one terminal = one session) ──────────────────────
# Every path to the hardware shares one FIFO lock, so the poller, "Fetch logs
# now", diagnostics and the LAN agent can never collide with each other. A
# second caller gets DEVICE_BUSY / HTTP 409 instead of knocking the first one
# off the device. These are safety knobs — the defaults suit real hardware.
# ZK_LOCK_WAIT_MS=15000          # how long a person's device action queues when busy (0 = refuse; the poll never queues)
# ZK_LOCK_STALE_MS=120000        # a wedged session is force-released after this
# ZK_SESSION_GAP_MS=350          # pause between sessions so the device releases the socket
# ZK_EXPLICIT_HANDSHAKE=true     # false = let node-zklib connect blindly (no Comm Key support)

# ── Cloud-to-school device bridge (Render / remote hosting) ───────────────
# On the cloud service set ZK_MODE=bridge and a long random token. Copy the
# SAME token to the LAN machine running `npm --prefix server run agent`.
# DEVICE_BRIDGE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# ATT_API_URL=https://your-att-service.onrender.com  # agent only
# DEVICE_BRIDGE_COMMAND_TIMEOUT_MS=60000
# DEVICE_BRIDGE_ONLINE_WINDOW_MS=30000
# DEVICE_BRIDGE_POLL_INTERVAL_MS=2000                 # agent polling interval
# DEVICE_BRIDGE_HEARTBEAT_INTERVAL_MS=8000
# DEVICE_BRIDGE_AGENT_ID=school-office-pc             # optional, agent only

# ── Access control ────────────────────────────────────────────────────────
# REQUIRED if you expose the UI beyond the school LAN (internet/port-forward/
# tunnel). Unset = open access for everyone on the local network.
# APP_PASSWORD=change-me-to-a-strong-password
# APP_TOKEN_SALT=any-random-string     # rotated tokens if compromised

# ── Background poller ─────────────────────────────────────────────────────
POLL_ENABLED=true
POLL_INTERVAL_MINUTES=1

# Retry / circuit breaker for an unreachable device
ZK_RETRY_ATTEMPTS=3
ZK_RETRY_BASE_DELAY_MS=750
ZK_BREAKER_THRESHOLD=5
ZK_BREAKER_COOLDOWN_MS=60000

# ── Development-only (never used in production) ───────────────────────────
# SEED_DEMO=true                 # create fake roster+history on empty DB
# SEED_HISTORY_DAYS=9
# ZK_MOCK_DAY_MODE=complete      # mock sim: 'complete' | 'live'
# ZK_MOCK_FAILURE_RATE=0         # mock sim: 0..1 random connection drops
